# Database (local Docker or Neon for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian
PORT=3000

# Temporal (local Docker or Temporal Cloud for production)
TEMPORAL_ADDRESS=localhost:7233

# Alchemy (Base on-chain detection)
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_SIGNING_KEY=your_alchemy_signing_secret_here
ALCHEMY_WEBHOOK_ID=your_alchemy_webhook_id_here

# Treasury wallet (signs USDC transfers on Base)
TREASURY_PRIVATE_KEY=your_treasury_wallet_private_key_here
